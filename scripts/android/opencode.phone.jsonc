{
  "$schema": "https://opencode.ai/config.json",

  // Unlimited on OpenCode Go, and the only one of the two free models that does
  // not train on request data (Iceman Contributor Free does). Region-restricted,
  // but available across Europe. Switch with /models if it ever disappears.
  "model": "opencode-go/beam-free",

  // Built-in search needs a paying provider; the keyless MCP server below does it.
  "websearch": false,

  // No plugins: opencode-mem is a desktop plugin, and playwright MCP would need
  // Node, which the phone does not have.
  "plugins": [],

  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],

  "mcp": {
    "servers": {
      // Knowledge base as tools: search/append/pending/review/rmfact/stats.
      "ai-memory": {
        "type": "local",
        "command": ["python", "__HOME__/memory/adapters/mcp/server.py"],
        "disabled": false
      },
      // Keyless DuckDuckGo search, so the phone is not blind without a paid key.
      "websearch": {
        "type": "local",
        "command": ["python", "__HOME__/websearch/server.py"],
        "disabled": false
      }
    }
  }
}
